# =============================================================================
# S3 Explorer — Deploy configuration
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# Required for first start: DOMAIN, ADMIN_USER, ADMIN_PASS, SESSION_SECRET,
# TOTP_ENCRYPTION_KEY. Everything else has sensible defaults.
# =============================================================================

# --- TLS / Domain --------------------------------------------------------------
# Public FQDN that resolves to this server. Used for:
#   - Caddy TLS (Let's Encrypt automatic cert OR internal CA — see Caddyfile)
#   - ALLOWED_HOSTS / ALLOWED_ORIGINS in the app (CSRF / DNS-rebinding defense)
#
# Examples:
#   DOMAIN=s3.empresa.com         # public, Let's Encrypt auto-cert
#   DOMAIN=s3.intranet.local      # internal — uncomment "tls internal" in Caddyfile
DOMAIN=s3.empresa.com

# --- Initial admin (bootstrap only) -------------------------------------------
# Used the first time the container starts with an empty users.json. After first
# login the admin enrolls TOTP and can create more users from the UI.
# After first login, change this password from "Mi cuenta" — these values are
# only honored when users.json is empty.
#
# Generate a strong password:   openssl rand -base64 24 | tr -d '+/=' | head -c 24
ADMIN_USER=admin
ADMIN_PASS=CHANGE-ME-RUN-openssl-rand-base64-24

# --- Session signing secret ---------------------------------------------------
# HMAC-SHA256 key for session cookies. If unset, an ephemeral key is generated
# at startup and ALL SESSIONS ARE INVALIDATED ON RESTART. Set in production.
# Generate:   openssl rand -hex 32
SESSION_SECRET=

# --- TOTP secret encryption key -----------------------------------------------
# AES-256-GCM key for encrypting TOTP secrets at rest in users.json. Must be
# 64 hex chars (32 bytes). If unset, ephemeral key is generated → existing TOTP
# enrollments become undecryptable on restart. ROTATING this key invalidates
# all existing TOTP enrollments; admin can reset users' TOTP from the UI.
# Generate:   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# --- Session TTL (optional, default 14400 = 4 hours) --------------------------
# Absolute timeout from login (not idle-reset).
#   14400 = 4 hours (recommended)
#   28800 = 8 hours (full workday)
#   43200 = 12 hours (lax)
SESSION_TTL_SECONDS=14400

# --- Upload limits (optional, default 524288000 = 500 MB) ---------------------
# Max upload size per file in bytes. Each upload buffers to tmpfs (capped at 2g
# in docker-compose) before streaming to S3.
#   524288000  = 500 MB (covers 95% of office files)
#   1073741824 = 1 GB
#   2147483648 = 2 GB
# If you raise this above 5 GB, update Caddyfile's `request_body max_size` too.
MAX_UPLOAD_BYTES=524288000

# --- Password breach check (optional, default 1 = on) -------------------------
# Validates new passwords against HIBP (haveibeenpwned.com) via k-anonymity —
# only the first 5 chars of the SHA-1 are sent. Fails open if HIBP API is
# unreachable. Set to 0 to disable.
CHECK_HIBP=1

# --- SSRF hardening for the S3 endpoint header (optional) ---------------------
# The app must accept arbitrary S3 endpoints (MinIO, R2, Vultr, etc.) including
# internal Docker hostnames, so we DO NOT denylist all internal IPs. We do block
# well-known cloud metadata endpoints by default to prevent an authenticated
# user from exfiltrating IAM credentials via SSRF if the host runs IMDSv1.
#
# Blocked by default: 169.254.169.254, fd00:ec2::254, metadata.google.internal,
# metadata.azure.com.
#
# Set BLOCK_METADATA_ENDPOINTS=0 only if you trust every user with full SSRF.
BLOCK_METADATA_ENDPOINTS=1

# Additional exact-match hostnames to deny (comma-separated, optional):
#   S3_DENY_HOSTS=internal-redis,backend.private,127.0.0.1
S3_DENY_HOSTS=
