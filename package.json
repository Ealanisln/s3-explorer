{
  "name": "s3-explorer",
  "version": "1.2.0",
  "description": "MinIO-like web console for any S3-compatible storage",
  "author": "Emmanuel Alanis (https://github.com/Ealanisln)",
  "contributors": [
    "Aziel Pichardo (https://github.com/AzielPD)",
    "Jose Luis Bravo (https://github.com/jlvobra)"
  ],
  "main": "dist/server.js",
  "bin": {
    "s3-explorer-mcp": "dist/mcp/cli.js"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -b",
    "build:clean": "rm -rf dist public/dist *.tsbuildinfo && tsc -b",
    "typecheck": "tsc -b --noEmit",
    "watch": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/lib-storage": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "mime-types": "^2.1.35",
    "multer": "^2.0.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
